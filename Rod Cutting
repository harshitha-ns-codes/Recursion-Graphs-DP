//Tabulation
int RodCutting(int n, vector<int>& price) {

    vector<vector<int>> dp(n, vector<int>(n + 1, 0));

    // Base case: ind = 0
    for(int target = 0; target <= n; target++) {
        dp[0][target] = target * price[0];
    }

    // Fill the rest of the table
    for(int ind = 1; ind < n; ind++) {

        int rodLength = ind + 1;

        for(int target = 0; target <= n; target++) {

            int notTake = dp[ind - 1][target];

            int take = INT_MIN;

            if(rodLength <= target) {
                take = price[ind] +
                       dp[ind][target - rodLength];
            }

            dp[ind][target] = max(take, notTake);
        }
    }

    return dp[n - 1][n];
}

//Space Optimization
int RodCutting(int n, vector<int>& price) {

    vector<int> dp(n + 1, 0);

    // Base case: only pieces of length 1
    for(int target = 0; target <= n; target++) {
        dp[target] = target * price[0];
    }

    // Process remaining pieces
    for(int ind = 1; ind < n; ind++) {

        int rodLength = ind + 1;

        for(int target = 0; target <= n; target++) {

            int notTake = dp[target];

            int take = INT_MIN;

            if(rodLength <= target) {
                take = price[ind] + dp[target - rodLength];
            }

            dp[target] = max(take, notTake);
        }
    }

    return dp[n];
}
