
class Solution {
public:
    bool parseBoolExpr(string expression) {
        stack<char> st;

        for (char ch : expression) {
            if (ch == ',' || ch == '(') continue;

            if (ch != ')') {
                st.push(ch);
            } 
            else {
                int t = 0, f = 0;

                while (st.top() != '!' &&
                       st.top() != '&' &&
                       st.top() != '|') {
                    char val = st.top();
                    st.pop();

                    if (val == 't') t++;
                    else if (val == 'f') f++;
                }

                char op = st.top();
                st.pop();

                if (op == '!') {
                    st.push(f ? 't' : 'f');
                } 
                else if (op == '&') {
                    st.push(f ? 'f' : 't');
                } 
                else {
                    st.push(t ? 't' : 'f');
                }
            }
        }

        return st.top() == 't';
    }
};
