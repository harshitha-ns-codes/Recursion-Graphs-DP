class Solution {
private:
    bool f(int i, int j, string &s, string &p,
           vector<vector<int>>& dp) {
        if (i == 0 && j == 0)
            return true;

        // Pattern empty, string not empty
        if (j == 0)
            return false;

        // String empty
        if (i == 0) {
            for (int k = 1; k <= j; k++) {
                if (p[k - 1] != '*')
                    return false;
            }
            return true;
        }

        if (dp[i][j] != -1)
            return dp[i][j];

        // Match or ?
        if (s[i - 1] == p[j - 1] || p[j - 1] == '?') {
            return dp[i][j] = f(i - 1, j - 1, s, p, dp);
        }

        // *
        if (p[j - 1] == '*') {
            return dp[i][j] =
                f(i - 1, j, s, p, dp) ||
                f(i, j - 1, s, p, dp);
        }

        return dp[i][j] = false;
    }

public:
    bool isMatch(string s, string p) {

        int n = s.size();
        int m = p.size();

        vector<vector<int>> dp(n + 1,
                               vector<int>(m + 1, -1));

        return f(n, m, s, p, dp);
    }
};

//Tabulation
class Solution {
public:
    bool isMatch(string s, string p) {

        int n = s.size();
        int m = p.size();

        vector<vector<bool>> dp(n + 1, vector<bool>(m + 1, false));

        // Both empty
        dp[0][0] = true;

        // Empty string vs pattern
        // Can only match if pattern consists entirely of '*'
        for (int j = 1; j <= m; j++) {
            if (p[j - 1] == '*')
                dp[0][j] = dp[0][j - 1];
        }

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {

                // Normal character or '?'
                if (s[i - 1] == p[j - 1] || p[j - 1] == '?') {
                    dp[i][j] = dp[i - 1][j - 1];
                }

                // '*'
                else if (p[j - 1] == '*') {
                    dp[i][j] = dp[i - 1][j] || dp[i][j - 1];
                }

                else {
                    dp[i][j] = false;
                }
            }
        }

        return dp[n][m];
    }
};

//Space Optimization
class Solution {
public:
    bool isMatch(string s, string p) {

        int n = s.size();
        int m = p.size();

        vector<bool> prev(m + 1, false);
        vector<bool> cur(m + 1, false);

        // Empty string and empty pattern
        prev[0] = true;

        // Empty string vs pattern
        for (int j = 1; j <= m; j++) {
            if (p[j - 1] == '*')
                prev[j] = prev[j - 1];
        }

        for (int i = 1; i <= n; i++) {

            // Empty pattern cannot match non-empty string
            cur[0] = false;

            for (int j = 1; j <= m; j++) {

                if (s[i - 1] == p[j - 1] || p[j - 1] == '?') {
                    cur[j] = prev[j - 1];
                }

                else if (p[j - 1] == '*') {
                    cur[j] = prev[j] || cur[j - 1];
                }

                else {
                    cur[j] = false;
                }
            }

            prev = cur;
        }

        return prev[m];
    }
};
