class Solution {
private:
int f(int i,int j,string &word1, string &word2,vector<vector<int>>&dp){
    if(i<0) return j+1;
    if(j<0) return i+1;
    if(dp[i][j] != -1) return dp[i][j];
    if(word1[i] == word2[j]) return 0+f(i-1,j-1,word1,word2,dp);
    else{
        int insert = 1+f(i,j-1,word1,word2,dp);
        int del = 1+f(i-1,j,word1,word2,dp);
        int replace = 1+f(i-1,j-1,word1,word2,dp);
        return dp[i][j]=min({insert,del,replace});
    }
    
}
public:
    int minDistance(string word1, string word2) 
    {
        int n = word1.size();
        int m = word2.size();
        vector<vector<int>>dp(n,vector<int>(m,-1));
        return f(n-1,m-1,word1,word2,dp);
        
    }
};

//tabulation
class Solution {
public:
    int minDistance(string word1, string word2) {

        int n = word1.size();
        int m = word2.size();

        vector<vector<int>> dp(
            n + 1,
            vector<int>(m + 1, 0)
        );

        // word1 -> empty string
        // Need i deletions
        for (int i = 0; i <= n; i++) {
            dp[i][0] = i;
        }

        // empty string -> word2
        // Need j insertions
        for (int j = 0; j <= m; j++) {
            dp[0][j] = j;
        }

        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= m; j++) {

                if (word1[i - 1] == word2[j - 1]) {

                    dp[i][j] = dp[i - 1][j - 1];

                }
                else {

                    int insert = 1 + dp[i][j - 1];
                    int del = 1 + dp[i - 1][j];
                    int replace = 1 + dp[i - 1][j - 1];

                    dp[i][j] = min({
                        insert,
                        del,
                        replace
                    });
                }
            }
        }

        return dp[n][m];
    }
};

//Space optimization
class Solution {
public:
    int minDistance(string word1, string word2) {

        int n = word1.size();
        int m = word2.size();

        vector<int> dp(m + 1);

        // word1 = ""
        // Need j insertions
        for (int j = 0; j <= m; j++) {
            dp[j] = j;
        }

        for (int i = 1; i <= n; i++) {

            // This is dp[i][0]
            int diagonal = dp[0];
            dp[0] = i;

            for (int j = 1; j <= m; j++) {

                // Save old dp[j]
                // old dp[j] = dp[i-1][j]
                int temp = dp[j];

                if (word1[i - 1] == word2[j - 1]) {

                    dp[j] = diagonal;

                }
                else {

                    int insert = dp[j - 1];
                    int del = dp[j];
                    int replace = diagonal;

                    dp[j] = 1 + min({
                        insert,
                        del,
                        replace
                    });
                }

                // diagonal for next j
                diagonal = temp;
            }
        }

        return dp[m];
    }
};
